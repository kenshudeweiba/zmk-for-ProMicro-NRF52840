#include <dt-bindings/zmk/matrix_transform.h>
#include <dt-bindings/gpio/gpio.h>

/ {
    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        wakeup-source;
        diode-direction = "col2row";

        col-gpios =
            <&gpio0 22 GPIO_ACTIVE_HIGH>,
            <&gpio0 24 GPIO_ACTIVE_HIGH>,
            <&gpio1 0 GPIO_ACTIVE_HIGH>,
            <&gpio0 11 GPIO_ACTIVE_HIGH>,
            <&gpio1 4 GPIO_ACTIVE_HIGH>,
            <&gpio1 6 GPIO_ACTIVE_HIGH>,
            <&gpio0 31 GPIO_ACTIVE_HIGH>,
            <&gpio0 29 GPIO_ACTIVE_HIGH>,
            <&gpio0 2 GPIO_ACTIVE_HIGH>,
            <&gpio1 15 GPIO_ACTIVE_HIGH>,
            <&gpio1 13 GPIO_ACTIVE_HIGH>,
            <&gpio1 11 GPIO_ACTIVE_HIGH>;

        row-gpios =
            <&gpio0 6 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
            <&gpio0 8 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
            <&gpio0 17 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
            <&gpio0 20 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>;

        debounce-press-ms = <5>;
        debounce-release-ms = <5>;
    };

    default_transform: matrix_transform {
        compatible = "zmk,matrix-transform";
        rows = <4>;
        columns = <12>;
        map = <
            RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5) RC(0,6) RC(0,7) RC(0,8) RC(0,9) RC(0,10) RC(0,11)
            RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5) RC(1,6) RC(1,7) RC(1,8) RC(1,9) RC(1,10) RC(1,11)
            RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5) RC(2,6) RC(2,7) RC(2,8) RC(2,9) RC(2,10) RC(2,11)
            RC(3,0) RC(3,1) RC(3,2) RC(255,255) RC(3,4) RC(255,255) RC(3,6) RC(3,7) RC(255,255) RC(255,255) RC(255,255) RC(3,11)
        >;
    };

    key_physical_attrs: key_physical_attrs {
        compatible = "zmk,key-physical-attrs";
        #key-cells = <7>;
    };

    physical_layout: physical_layout {
        compatible = "zmk,physical-layout";
        display-name = "Batoid 43 (Alice 8deg)";
        transform = <&default_transform>;
        kscan = <&kscan0>;
        keys  //                       w    h    x    y    rot   rx   ry
      = <&key_physical_attrs  100  100   125    0    800   175   50> // 0,0
      , <&key_physical_attrs  100  100   225   10    800   275   60> // 0,1
      , <&key_physical_attrs  100  100   325   19    800   375   69> // 0,2
      , <&key_physical_attrs  100  100   425   29    800   475   79> // 0,3
      , <&key_physical_attrs  100  100   525   38    800   575   88> // 0,4
      , <&key_physical_attrs  100  100   625   48    800   675   98> // 0,5
      , <&key_physical_attrs  100  100   825   48 (-800)   875   98> // 0,6
      , <&key_physical_attrs  100  100   925   38 (-800)   975   88> // 0,7
      , <&key_physical_attrs  100  100  1025   29 (-800)  1075   79> // 0,8
      , <&key_physical_attrs  100  100  1125   19 (-800)  1175   69> // 0,9
      , <&key_physical_attrs  100  100  1225   10 (-800)  1275   60> // 0,10
      , <&key_physical_attrs  100  100  1325    0 (-800)  1375   50> // 0,11
      , <&key_physical_attrs  175  100    75  100    800   162  150> // 1,0
      , <&key_physical_attrs  100  100   250  110    800   300  160> // 1,1
      , <&key_physical_attrs  100  100   350  119    800   400  169> // 1,2
      , <&key_physical_attrs  100  100   450  129    800   500  179> // 1,3
      , <&key_physical_attrs  100  100   550  138    800   600  188> // 1,4
      , <&key_physical_attrs  100  100   650  148    800   700  198> // 1,5
      , <&key_physical_attrs  100  100   850  148 (-800)   900  198> // 1,6
      , <&key_physical_attrs  100  100   950  138 (-800)  1000  188> // 1,7
      , <&key_physical_attrs  100  100  1050  129 (-800)  1100  179> // 1,8
      , <&key_physical_attrs  100  100  1150  119 (-800)  1200  169> // 1,9
      , <&key_physical_attrs  100  100  1250  110 (-800)  1300  160> // 1,10
      , <&key_physical_attrs  100  100  1350  100 (-800)  1400  150> // 1,11
      , <&key_physical_attrs  150  100    50  200    800   125  250> // 2,0
      , <&key_physical_attrs  100  100   300  210    800   350  260> // 2,1
      , <&key_physical_attrs  100  100   400  219    800   450  269> // 2,2
      , <&key_physical_attrs  100  100   500  229    800   550  279> // 2,3
      , <&key_physical_attrs  100  100   600  238    800   650  288> // 2,4
      , <&key_physical_attrs  100  100   700  248    800   750  298> // 2,5
      , <&key_physical_attrs  100  100   900  248 (-800)   950  298> // 2,6
      , <&key_physical_attrs  100  100  1000  238 (-800)  1050  288> // 2,7
      , <&key_physical_attrs  100  100  1100  229 (-800)  1150  279> // 2,8
      , <&key_physical_attrs  100  100  1200  219 (-800)  1250  269> // 2,9
      , <&key_physical_attrs  100  100  1300  210 (-800)  1350  260> // 2,10
      , <&key_physical_attrs  100  100  1400  200 (-800)  1450  250> // 2,11
      , <&key_physical_attrs  150  100   100  300    800   175  350> // 3,0
      , <&key_physical_attrs  100  100   200  310    800   250  360> // 3,1
      , <&key_physical_attrs  125  100   425  319    800   487  369> // 3,2
      , <&key_physical_attrs  125  100   425  329    800   487  379> // 3,3 ghost
      , <&key_physical_attrs  200  100   550  338    800   650  388> // 3,4
      , <&key_physical_attrs  200  100   550  348    800   650  398> // 3,5 ghost
      , <&key_physical_attrs  225  100   825  348 (-800)   937  398> // 3,6
      , <&key_physical_attrs  100  100  1050  338 (-800)  1100  388> // 3,7
      , <&key_physical_attrs  100  100  1050  329 (-800)  1100  379> // 3,8 ghost
      , <&key_physical_attrs  100  100  1050  319 (-800)  1100  369> // 3,9 ghost
      , <&key_physical_attrs  100  100  1050  310 (-800)  1100  360> // 3,10 ghost
      , <&key_physical_attrs  150  100  1300  300 (-800)  1375  350> // 3,11
        ;
    };

    caps_leds: caps_lock_gpio {
        compatible = "gpio-leds";
        caps_lock_led: caps_led {
            gpios = <&gpio0 10 GPIO_ACTIVE_LOW>;
        };
    };

    bt_leds: bt_status_gpio {
        compatible = "gpio-leds";
        bt_status_led: bt_led {
            gpios = <&gpio0 9 GPIO_ACTIVE_LOW>;
        };
    };

    chosen {
        zmk,physical-layout = &physical_layout;
    };
};
