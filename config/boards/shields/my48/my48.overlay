#include <dt-bindings/zmk/matrix_transform.h>
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/zmk/hid_indicators.h>

/ {
    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        wakeup-source;
        diode-direction = "col2row";

        col-gpios =
            <&gpio0 22 GPIO_ACTIVE_HIGH>,
            <&gpio0 24 GPIO_ACTIVE_HIGH>,
            <&gpio1 0 GPIO_ACTIVE_HIGH>,
            <&gpio0 11 GPIO_ACTIVE_HIGH>,
            <&gpio1 4 GPIO_ACTIVE_HIGH>,
            <&gpio1 6 GPIO_ACTIVE_HIGH>,
            <&gpio0 31 GPIO_ACTIVE_HIGH>,
            <&gpio0 29 GPIO_ACTIVE_HIGH>,
            <&gpio0 2 GPIO_ACTIVE_HIGH>,
            <&gpio1 15 GPIO_ACTIVE_HIGH>,
            <&gpio1 13 GPIO_ACTIVE_HIGH>,
            <&gpio1 11 GPIO_ACTIVE_HIGH>;

        row-gpios =
            <&gpio0 6 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
            <&gpio0 8 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
            <&gpio0 17 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
            <&gpio0 20 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>;

        debounce-press-ms = <5>;
        debounce-release-ms = <5>;
    };

    default_transform: matrix_transform {
        compatible = "zmk,matrix-transform";
        rows = <4>;
        columns = <12>;
        map = <
            RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5) RC(0,6) RC(0,7) RC(0,8) RC(0,9) RC(0,10) RC(0,11)
            RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5) RC(1,6) RC(1,7) RC(1,8) RC(1,9) RC(1,10) RC(1,11)
            RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5) RC(2,6) RC(2,7) RC(2,8) RC(2,9) RC(2,10) RC(2,11)
            RC(3,0) RC(3,1) RC(3,2) RC(255,255) RC(3,4) RC(255,255) RC(3,6) RC(3,7) RC(255,255) RC(255,255) RC(255,255) RC(3,11)
        >;
    };

    key_physical_attrs: key_physical_attrs {
        compatible = "zmk,key-physical-attrs";
        #key-cells = <7>;
    };

    physical_layout: physical_layout {
        compatible = "zmk,physical-layout";
        display-name = "Batoid 43 (Alice 8deg)";
        transform = <&default_transform>;
        kscan = <&kscan0>;
        keys  //                       w    h    x    y    rot   rx   ry
        = <&key_physical_attrs  100  100   125    0    800   175   50> // 0,0
        , <&key_physical_attrs  100  100   225    0    800   275   50> // 0,1
        , <&key_physical_attrs  100  100   325    0    800   375   50> // 0,2
        , <&key_physical_attrs  100  100   425    0    800   475   50> // 0,3
        , <&key_physical_attrs  100  100   525    0    800   575   50> // 0,4
        , <&key_physical_attrs  100  100   625    0    800   675   50> // 0,5
        , <&key_physical_attrs  100  100   725    0  (-800)   775   50> // 0,6
        , <&key_physical_attrs  100  100   825    0  (-800)   875   50> // 0,7
        , <&key_physical_attrs  100  100   925    0  (-800)   975   50> // 0,8
        , <&key_physical_attrs  100  100  1025    0  (-800)  1075   50> // 0,9
        , <&key_physical_attrs  100  100  1125    0  (-800)  1175   50> // 0,10
        , <&key_physical_attrs  100  100  1225    0  (-800)  1275   50> // 0,11
        , <&key_physical_attrs  175  100    75  100    800   162  150> // 1,0
        , <&key_physical_attrs  100  100   250  100    800   300  150> // 1,1
        , <&key_physical_attrs  100  100   350  100    800   400  150> // 1,2
        , <&key_physical_attrs  100  100   450  100    800   500  150> // 1,3
        , <&key_physical_attrs  100  100   550  100    800   600  150> // 1,4
        , <&key_physical_attrs  100  100   650  100    800   700  150> // 1,5
        , <&key_physical_attrs  100  100   750  100  (-800)   800  150> // 1,6
        , <&key_physical_attrs  100  100   850  100  (-800)   900  150> // 1,7
        , <&key_physical_attrs  100  100   950  100  (-800)  1000  150> // 1,8
        , <&key_physical_attrs  100  100  1050  100  (-800)  1100  150> // 1,9
        , <&key_physical_attrs  100  100  1150  100  (-800)  1200  150> // 1,10
        , <&key_physical_attrs  100  100  1250  100  (-800)  1300  150> // 1,11
        , <&key_physical_attrs  150  100    50  200    800   125  250> // 2,0
        , <&key_physical_attrs  100  100   300  200    800   350  250> // 2,1
        , <&key_physical_attrs  100  100   400  200    800   450  250> // 2,2
        , <&key_physical_attrs  100  100   500  200    800   550  250> // 2,3
        , <&key_physical_attrs  100  100   600  200    800   650  250> // 2,4
        , <&key_physical_attrs  100  100   700  200    800   750  250> // 2,5
        , <&key_physical_attrs  100  100   800  200  (-800)   850  250> // 2,6
        , <&key_physical_attrs  100  100   900  200  (-800)   950  250> // 2,7
        , <&key_physical_attrs  100  100  1000  200  (-800)  1050  250> // 2,8
        , <&key_physical_attrs  100  100  1100  200  (-800)  1150  250> // 2,9
        , <&key_physical_attrs  100  100  1200  200  (-800)  1250  250> // 2,10
        , <&key_physical_attrs  100  100  1300  200  (-800)  1350  250> // 2,11
        , <&key_physical_attrs  150  100   100  300    800   175  350> // 3,0
        , <&key_physical_attrs  100  100   200  200    800   250  250> // 3,1
        , <&key_physical_attrs  125  100   425  300    800   488  350> // 3,2
        , <&key_physical_attrs  125  100   425  300    800   488  350> // 3,3 ghost
        , <&key_physical_attrs  200  100   550  300    800   650  350> // 3,4
        , <&key_physical_attrs  200  100   550  300    800   650  350> // 3,5 ghost
        , <&key_physical_attrs  225  100   725  300  (-800)   838  350> // 3,6
        , <&key_physical_attrs  100  100   950  300  (-800)  1000  350> // 3,7
        , <&key_physical_attrs  100  100   950  300  (-800)  1000  350> // 3,8 ghost
        , <&key_physical_attrs  100  100   950  300  (-800)  1000  350> // 3,9 ghost
        , <&key_physical_attrs  100  100   950  300  (-800)  1000  350> // 3,10 ghost
        , <&key_physical_attrs  150  100  1200  300  (-800)  1275  350> // 3,11
        ;
    };

    caps_leds: caps_lock_gpio {
        compatible = "gpio-leds";
        caps_lock_led: caps_led {
            gpios = <&gpio0 10 GPIO_ACTIVE_LOW>;
        };
    };

    bt_leds: bt_status_gpio {
        compatible = "gpio-leds";
        bt_status_led: bt_led {
            gpios = <&gpio0 9 GPIO_ACTIVE_LOW>;
        };
    };

    caps_lock_indicator {
        compatible = "zmk,indicator-leds";
        status = "okay";

        caps_lock {
            leds = <&caps_lock_led>;
            indicator = <HID_INDICATOR_CAPS_LOCK>;
            active-brightness = <100>;
            inactive-brightness = <0>;
            disconnected-brightness = <0>;
            on-while-idle;
        };

        bt_connected {
            leds = <&bt_status_led>;
            indicator = <HID_INDICATOR_CAPS_LOCK>;
            active-brightness = <100>;
            inactive-brightness = <100>;
            disconnected-brightness = <0>;
            on-while-idle;
        };
    };

    chosen {
        zmk,physical-layout = &physical_layout;
    };
};
