#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <behaviors.dtsi>

/ {
    behaviors {
        legacy_boot: behavior_legacy_boot {
            compatible = "zmk,behavior-legacy-bootloader";
            display-name = "Legacy Bootloader";
            #binding-cells = <0>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        layer_0 {
            bindings = <
                &kp ESC &kp Q &kp W &kp E &kp R &kp T &kp Y &kp U &kp I &kp O &kp P &kp BSPC
                &kp TAB &kp A &kp S &kp D &kp F &kp G &kp H &kp J &kp K &kp L &kp SEMI &kp SQT
                &kp LSHFT &kp Z &kp X &kp C &kp V &kp B &kp N &kp M &kp COMMA &kp DOT &kp FSLH &kp RSHFT
                &kp LCTRL &kp LBRC &kp LALT &none &lt 1 SPACE &none &lt 2 SPACE &kp RALT &none &none &none &kp RCTRL
            >;
        };

        layer_1 {
            bindings = <
                &kp GRAVE &kp N1 &kp N2 &kp N3 &kp N4 &kp N5 &kp N6 &kp N7 &kp N8 &kp N9 &kp N0 &kp DEL
                &kp CAPS &none &none &none &none &none &kp LGUI &kp LEFT &kp DOWN &kp RIGHT &none &kp ENTER
                &trans &none &none &none &none &none &none &none &none &none &none &trans
                &trans &kp RBRC &trans &none &trans &none &trans &trans &none &none &none &trans
            >;
        };

        layer_2 {
            bindings = <
                &none &kp F1 &kp F2 &kp F3 &kp F4 &kp F5 &kp F6 &kp F7 &kp F8 &kp F9 &kp F10 &kp BSLH
                &none &kp F11 &kp F12 &mo 4 &none &none &bt BT_CLR &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4
                &trans &out OUT_USB &out OUT_BLE &none &none &legacy_boot &kp C_VOL_UP &kp C_VOL_DN &none &none &legacy_boot &trans
                &trans &studio_unlock &trans &none &trans &none &trans &trans &none &none &none &trans
            >;
        };

        // Layers 3-11: reserved for ZMK Studio to configure (mouse keys, etc.)
        layer_3 { status = "reserved"; display-name = "Layer 4"; };
        // Layer 4: mouse keys. Parameters are baked in here because ZMK Studio
        // does not expose parameter metadata for &mmv / &msc behaviors.
        // Row 0: r=left click, y=scroll down, i=move up
        // Row 1: f=right click, h=scroll up, j=left, k=down, l=right
        layer_4 {
            display-name = "Mouse";
            bindings = <
                &trans &trans &trans &trans &mkp LCLK &trans &msc SCRL_DOWN &trans &mmv MOVE_UP &trans &trans &trans
                &trans &trans &trans &trans &mkp RCLK &trans &msc SCRL_UP &mmv MOVE_LEFT &mmv MOVE_DOWN &mmv MOVE_RIGHT &trans &trans
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &none &trans &none &trans &trans &none &none &none &trans
            >;
        };
        layer_5 { status = "reserved"; display-name = "Layer 6"; };
        layer_6 { status = "reserved"; display-name = "Layer 7"; };
        layer_7 { status = "reserved"; display-name = "Layer 8"; };
        layer_8 { status = "reserved"; display-name = "Layer 9"; };
        layer_9 { status = "reserved"; display-name = "Layer 10"; };
        layer_10 { status = "reserved"; display-name = "Layer 11"; };
        layer_11 { status = "reserved"; display-name = "Layer 12"; };
    };
};
